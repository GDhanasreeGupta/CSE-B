pipeline {
    
    agent any

    stages {
        
        stage('Complie') {

            steps {
                
                dir('src') {
                    bat 'javac Hello.java'
                }
            }
        }

        stages('Run') {

            steps {
                
                dir('src') {
                    bat 'java Hello'
                }
            }
        }
    }
    
    post {

        success {

            echo 'BUILD SUCCESSFUL'

        }

        failure {

            echo 'BUILD FAILED'
        }
    }
}